# Local dev uses Vite proxy — leave unset or use /api
# VITE_API_URL=/api

# Vercel: point to your deployed backend (include /api)
# VITE_API_URL=https://your-backend.vercel.app/api

# Google Sign-In (OAuth 2.0 Web client ID — same value as backend GOOGLE_OAUTH_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# In Google Cloud Console → Credentials → add Authorized JavaScript origins:
#   http://localhost:5173
#   https://astrology-frontend.vercel.app

# Google Analytics 4
# VITE_GA_MEASUREMENT_ID=G-812K9FQ5NE
# Comma-separated account emails to exclude from analytics (your test/admin logins)
# VITE_GA_EXCLUDED_EMAILS=you@example.com
# Optional: comma-separated public IPs to exclude (home/office network)
# VITE_GA_EXCLUDED_IPS=203.0.113.10
# Also add internal traffic rules in GA4 Admin for network-level filtering
